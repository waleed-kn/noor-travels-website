# Database (Neon Postgres)
# DATABASE_URL uses pooled connection (port 6543 / pgbouncer)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# DIRECT_URL uses direct connection for migrations
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Auth.js Admin Authentication
AUTH_SECRET="generate-a-32-byte-secret-using-openssl-rand-base64-32"
ADMIN_EMAIL="admin@noortravels.pk"
ADMIN_PASSWORD="super-secure-admin-password"

# Email Delivery (Resend)
RESEND_API_KEY="re_sample_123456789"
AGENCY_EMAIL="info@noortravels.pk"

# Spam Protection (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAA..."
TURNSTILE_SITE_KEY="0x4AAAAAA..."
TURNSTILE_SECRET_KEY="0x4AAAAAA..."

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME="noor-travels"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="sample_secret_key"

# Public Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
